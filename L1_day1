## Terraform Task - Create EC2 (C5.xlarge)

provider "aws" {
  region = "us-east-1"
}

resource "aws_instance" "yamuna-ec2"
ami = "ami-0abcd1234abcd1234"
instance_type = "(c5.xlarge)"

tags  = {
  name: "yamuna-ec2"
}

==================================================
## Kubernetes Tasks - Create nginx Pod

apiVersion: v1
kind: Pod
metadata:
  name: cg-pod
spec:
  containers:
    - name: web
      image: nginx:latest
      ports:
        - containersPort: 80

